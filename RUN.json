{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": ".",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        ["npm", "install", "--no-audit", "--no-fund"]
      ],
      "build": [
        ["npm", "run", "build"]
      ],
      "start": ["node", "scripts/serve.js"],
      "port": 4100,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "env": {
        "REACT_APP_API_ROOT": {
          "dev": "${service:api.origin}/api"
        }
      },
      "test": [
        ["npx", "cross-env", "CI=true", "npm", "test", "--", "--watchAll=false"]
      ]
    }
  ]
}
