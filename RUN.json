{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": ".",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        ["npm", "install", "--no-audit", "--no-fund"]
      ],
      "build": [
        ["npm", "run", "build"]
      ],
      "start": ["npm", "start", "--", "--port", "${PORT}"],
      "port": 4100,
      "port_env": "PORT",
      "ready_timeout_s": 60,
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "env": {
        "REACT_APP_API_ROOT": "${service:api.origin}/api"
      },
      "test": [
        ["npm", "test"]
      ]
    }
  ]
}
